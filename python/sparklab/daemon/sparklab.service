# SparkLab engine supervisor — reference systemd user unit for Linux and WSL.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp sparklab.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sparklab
#   systemctl --user status sparklab
#
# The installer places `sparklab` under ~/.local/bin by default. Override ExecStart when
# using a checkout-local virtual environment. KillMode=process is intentional: restarting
# this lightweight control plane must not unload a live model-serving child.

[Unit]
Description=SparkLab engine supervisor
Documentation=https://github.com/sixteen-miles-labs/sparklab/blob/main/python/sparklab/daemon/README.md
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/sparklab daemon --host 127.0.0.1 --port 1900
Restart=always
RestartSec=1
KillMode=process
KillSignal=SIGTERM

[Install]
WantedBy=default.target
